# CMRE Engine — Configuração de ambiente
# Copie este arquivo para .env e preencha os valores

# ─── Backend de geração ──────────────────────────────────────────────────────
# Opções: gemini | fooocus | dalle
CMRE_BACKEND=gemini

# ─── Gemini (recomendado — gratuito 500 imgs/dia) ────────────────────────────
# Obtenha em: https://aistudio.google.com/apikey
GEMINI_API_KEY=sua_chave_gemini_aqui

# ─── Fooocus local (offline, DirectML, 4GB VRAM) ─────────────────────────────
# Inicie Fooocus com: python entry_with_update.py --directml
FOOOCUS_HOST=http://localhost:7865

# ─── DALL-E 3 (OpenAI — pago ~$0.04/imagem) ──────────────────────────────────
OPENAI_API_KEY=sua_chave_openai_aqui

# ─── Configurações gerais ─────────────────────────────────────────────────────
# true = exibe logs detalhados de cada camada
CMRE_VERBOSE=true

# Pasta de saída das imagens geradas
CMRE_OUTPUT_DIR=outputs
